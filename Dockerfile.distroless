# Distroless Docker build for maximum security and minimal attack surface
# Stage 1: Builder
FROM rust:latest AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY benches ./benches

# Build release binary with optimizations
RUN cargo build --release

# Stage 2: Runtime - using distroless
FROM gcr.io/distroless/base-debian12:nonroot

# Copy CA certificates from builder
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Create application directories (as nonroot user - UID 65532)
COPY --chown=65532:65532 --from=builder /build/target/release/sftp-s3 /usr/local/bin/sftp-s3

WORKDIR /app

# Expose SFTP port
EXPOSE 2222

# Health check - requires curl in distroless base
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["/usr/bin/curl", "-f", "http://127.0.0.1:2222/health"] || exit 1

# Execute the SFTP server binary directly
ENTRYPOINT ["/usr/local/bin/sftp-s3"]
